{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(done)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(git init:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(npm run build:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run lint:*)",
      "Bash(npm install:*)",
      "Bash(rg:*)",
      "WebSearch",
      "WebFetch(domain:github.com)"
    ],
    "ask": [
      "Read(./.env)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(pulumi stack rm *)",
      "Bash(pulumi destroy *)",
      "Bash(pulumi up --yes *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
