# [user] stuff is in ~/.gitconfig.local
# and not checked into config to allow for
# work vs. personal git configs
# at the very least it should include
# [user]
#   name = Jim Ray
#   email = 470581+jimray@users.noreply.github.com
[include]
  path = ~/.gitconfig.local

[push]
	default = simple
	autoSetupRemote = true
[fetch]
	prune = true
[core]
	# ~ not an absolute path, so this works on Linux and FreeBSD too
	excludesfile = ~/.gitignore
	editor = nvim
	# core.ignorecase is NOT set here on purpose. Git autodetects it per-repo
	# at clone/init time. Forcing it globally to true means git misses
	# case-only renames on case-sensitive filesystems (i.e. every Lima VM).

[alias]
  # get the branch name, used later
  branch-name = "!git rev-parse --abbrev-ref HEAD"

  # add a files
	a = add

  # add all tracked files
  au = add -u

  # add all UNtracked files -- use with caution, probably at the start of a project
  az = "!git ls-files -o --exclude-standard -z | xargs -0 git add"

  # add all tracked files AND commit
  aux = "!git add -u && git commit"

  # create a new branch and check it out
	b = checkout -b

  # show a nice history readout
  hist = log --oneline --graph --all --decorate

  # list branches
  ls = branch -vv

  # because you gotta checkout main a lot
  main = checkout main

  # show a pretty log
  plog = log --pretty=oneline

  # get submodules
  mods = pull --recurse-submodules

  # remote rebase from origin
  rrb = "!git fetch origin $(git branch-name) && git rebase origin/$(git branch-name)"

  # better pull and fetch -- only from the current branch not *every* branch
  pu = "!git pull origin $(git branch-name)"
  fe = "!git fetch origin $(git branch-name)"

  c = commit
  cm = commit -m
	d = diff
  g = grep
	o = checkout
	s = status

  #blame without whitespace
  blame = blame -w -M -C

  #more good aliases here!
  #https://gist.github.com/jhermsmeier/ae195a83b4c3d212c770

# make the default branch name be `main` instead of `master`
[init]
	defaultBranch = main
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
[pull]
	rebase = true

# NOTE: do not add a [user] block here. Git applies the LAST value it sees,
# and the [include] at the top of this file is expanded in place, so anything
# set down here silently wins over ~/.gitconfig.local -- which defeats the
# whole point of keeping work and personal identities separate.

[branch]
	autoSetupMerge = simple
	# newest branches first in `git branch` (git 2.19+)
	sort = -committerdate

# Modern git defaults. All of these are built in -- no extra tools needed.
[merge]
	# zdiff3 shows the common ancestor in conflict markers, so you can see
	# what each side actually changed instead of guessing (git 2.35+)
	conflictStyle = zdiff3
[diff]
	# noticeably better hunk boundaries than the default myers algorithm
	algorithm = histogram
	# highlight moved lines in a different color than added/removed
	colorMoved = default
	mnemonicPrefix = true
	renames = true
[rerere]
	# remember how you resolved a conflict and replay it next time.
	# Pairs well with pull.rebase = true above.
	enabled = true
	autoupdate = true
[rebase]
	autosquash = true
	# stash dirty worktree before rebasing, restore after
	autostash = true
	# keep stacked branches pointing at the right commits (git 2.38+)
	updateRefs = true
[commit]
	# show the full diff in the commit message editor
	verbose = true
[column]
	ui = auto
[tag]
	sort = -version:refname
