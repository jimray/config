reload() {
    # Reload main zsh config
    source ~/.zshrc

    # Unload and reload all autoloaded functions from .zfunc
    # Mirrors the glob in .zshrc: (N) so a missing dir isn't an error,
    # [^_] so completion functions are left to compinit.
    for func in ~/.zfunc/[^_]*(N:t); do
        unfunction $func 2>/dev/null
        autoload -Uz $func
    done

    echo "Reloaded .zshrc and functions from .zfunc/"
}
