# Homebrew is already activated by .zshenv, so there's no unguarded
# `brew shellenv` here -- calling it before checking that brew exists just
# errors out on a Mac that hasn't been bootstrapped yet.

if [ -x "$(command -v brew)" ]; then
    # use homebrew sqlite
    export PATH="$(brew --prefix sqlite)/bin:$PATH"

    #use homebrew curl
    export PATH="$(brew --prefix curl)/bin:$PATH"

    # make the default bundle file invisible
    export HOMEBREW_BUNDLE_FILE="$HOME/.Brewfile"
fi

# compinit moved to .zshrc so macOS and Linux initialise completions
# the same way, and so it always runs after ~/.zfunc joins fpath.

if [ -e /Applications/Nova.app/ ]; then
  alias coda='nova'
fi
